{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logseq Desktop",
  "version": "0.0.0",
  "identifier": "com.logseq.desktop",
  "build": {
    "beforeBuildCommand": "cd .. && pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Logseq",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
